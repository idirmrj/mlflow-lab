name: churn-workshop

python_env: python_env.yaml

entry_points:
  main:
    parameters:
      max_depth: {type: int, default: 4}
      n_estimators: {type: int, default: 300}
      learning_rate: {type: float, default: 0.1}
    command: >-
      python src/train.py
      --max-depth {max_depth}
      --n-estimators {n_estimators}
      --learning-rate {learning_rate}
